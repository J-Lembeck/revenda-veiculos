	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (Number(pm.collectionVariables.get('poll:' + pm.info.requestId) || 0) > 0 && pm.info.requestName.indexOf('429') !== 0) {",
					"    setTimeout(() => {}, 1000);",
					"}",
					"",
					"const limits = { 'POST /purchases': 10, 'POST /customers': 5 };",
					"const route = pm.request.method + ' ' + pm.request.url.getPath();",
					"if (limits[route]) {",
					"    const windowMs = 61000;",
					"    const now = Date.now();",
					"    const logKey = 'rateLimit:' + route;",
					"    const recent = JSON.parse(pm.collectionVariables.get(logKey) || '[]').filter((at) => now - at < windowMs);",
					"    let sendAt = now;",
					"    if (pm.info.requestName.indexOf('429') !== 0 && recent.length >= limits[route]) {",
					"        sendAt = recent[recent.length - limits[route]] + windowMs;",
					"    }",
					"    recent.push(sendAt);",
					"    pm.collectionVariables.set(logKey, JSON.stringify(recent));",
					"    if (sendAt > now) {",
					"        console.log('Aguardando ' + Math.ceil((sendAt - now) / 1000) + ' s pelo limite de taxa de ' + route + '.');",
					"        setTimeout(() => {}, sendAt - now);",
					"    }",
					"}",
					"",
					"if (pm.request.auth && pm.request.auth.type === 'bearer') {",
					"    const token = pm.variables.replaceIn(String(pm.request.auth.parameters().get('token') || ''));",
					"    if (!token) console.warn('Sem token em \"' + pm.info.requestName + '\": entre com a pessoa na pasta 00 ou peça o token de serviço na pasta 01.');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const raw = pm.request.url.toString();",
					"const isFrom = (variable) => raw.indexOf('{{' + variable + '}}') === 0 || raw.indexOf(pm.variables.get(variable)) === 0;",
					"const management = ['vehiclesManagementUrl', 'customersManagementUrl', 'salesManagementUrl', 'gatewayManagementUrl'].some(isFrom);",
					"if (!isFrom('keycloakUrl') && !management) {",
					"    const requestId = pm.response.headers.get('X-Request-Id');",
					"    pm.test('[contrato] X-Request-Id na resposta', () => pm.expect(requestId, 'X-Request-Id').to.be.a('string').and.not.empty);",
					"    const type = pm.response.headers.get('Content-Type') || '';",
					"    const body = type.indexOf('json') >= 0 && pm.response.text() ? pm.response.json() : null;",
					"    if (pm.response.code >= 400 && body) {",
					"        pm.test('[contrato] erro { code, message, requestId, fields } com o requestId do cabeçalho', () => {",
					"            pm.expect(body.code, 'code').to.be.a('string').and.match(/^[A-Z_]+$/);",
					"            pm.expect(body.message, 'message').to.be.a('string').and.not.empty;",
					"            pm.expect(body.requestId, 'requestId').to.eql(requestId);",
					"            pm.expect(body.fields, 'fields').to.be.an('array');",
					"            pm.expect(body, 'sem detalhe interno').to.not.have.any.keys('trace', 'exception', 'stackTrace', 'error', 'path');",
					"        });",
					"    }",
					"    if (body) {",
					"        const notCents = [];",
					"        const walk = (node, path) => {",
					"            if (Array.isArray(node)) {",
					"                node.forEach((item, i) => walk(item, path + '[' + i + ']'));",
					"            } else if (node && typeof node === 'object') {",
					"                Object.keys(node).forEach((key) => {",
					"                    if (/Cents$/.test(key) && node[key] !== null && !Number.isInteger(node[key])) notCents.push(path + '.' + key);",
					"                    walk(node[key], path + '.' + key);",
					"                });",
					"            }",
					"        };",
					"        walk(body, '$');",
					"        pm.test('[contrato] dinheiro em centavos inteiros (*Cents)', () => pm.expect(notCents).to.be.empty);",
					"    }",
					"    if (pm.response.code === 401 && body && body.code === 'UNAUTHENTICATED' && !isFrom('gatewayUrl')) {",
					"        pm.test('[contrato] 401 com WWW-Authenticate: Bearer', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.match(/^Bearer/));",
					"    }",
					"}"
				]
			}
		}
	],
