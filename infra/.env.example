# Valores só de desenvolvimento local. Copie para infra/.env (git-ignorado) antes do docker compose.

POSTGRES_SUPERUSER_PASSWORD=dev-only-postgres
VEHICLES_DB_OWNER_PASSWORD=dev-only-vehicles-owner
VEHICLES_DB_APP_PASSWORD=dev-only-vehicles-app
CUSTOMERS_DB_OWNER_PASSWORD=dev-only-customers-owner
CUSTOMERS_DB_APP_PASSWORD=dev-only-customers-app
SALES_DB_OWNER_PASSWORD=dev-only-sales-owner
SALES_DB_APP_PASSWORD=dev-only-sales-app

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin
SALES_SERVICE_CLIENT_SECRET=dev-only-sales-service-secret
CUSTOMERS_SERVICE_CLIENT_SECRET=dev-only-customers-service-secret

PAYMENT_GATEWAY_API_KEY=dev-only-payment-gateway-api-key
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret
